{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cityverse.local/specs/city-config-v1",
  "title": "CityVerse city configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "displayName", "country", "countryCode", "state", "bbox", "projection", "tileSize", "enabledWorldLayers"],
  "properties": {
    "slug": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "displayName": {"type": "string", "minLength": 1},
    "country": {"type": "string", "minLength": 1},
    "countryCode": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "state": {"type": "string", "minLength": 1},
    "projection": {"const": "cityverse-metric-v1"},
    "tileSize": {"type": "integer", "minimum": 10, "maximum": 10000},
    "bbox": {"$ref": "#/$defs/bbox"},
    "enabledWorldLayers": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["buildings", "roads", "terrain", "pois", "navigation"]}
    },
    "build": {"type": "object"}
  },
  "$defs": {
    "bbox": {
      "type": "object", "additionalProperties": false,
      "required": ["south", "west", "north", "east"],
      "description": "Runtime validators also require south < north and west < east.",
      "properties": {
        "south": {"type": "number", "minimum": -90, "maximum": 90},
        "north": {"type": "number", "minimum": -90, "maximum": 90},
        "west": {"type": "number", "minimum": -180, "maximum": 180},
        "east": {"type": "number", "minimum": -180, "maximum": 180}
      }
    }
  }
}
